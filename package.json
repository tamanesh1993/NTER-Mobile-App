{
  "name": "nter-mobile",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "nter.pro on a phone: the mobile app for the Niyantran research terminal (React + Vite + Capacitor).",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "dev:sample": "VITE_DATA_MODE=sample vite",
    "build": "vite build",
    "build:web": "TARGET=web vite build --outDir dist-web",
    "build:sample": "VITE_DATA_MODE=sample vite build --outDir dist-sample",
    "build:preview": "PREVIEW=1 VITE_DATA_MODE=sample vite build --outDir dist-preview",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint --max-warnings 0 src scripts eslint.config.js vite.config.js vitest.config.js vitest.setup.js",
    "cap:sync": "npm run build && cap sync",
    "android": "npm run build && cap sync android && cap open android",
    "ios": "npm run build && cap sync ios && cap open ios",
    "check:backend": "node scripts/check-backend.mjs",
    "test:smoke:live": "node scripts/smoke-live-mock.mjs",
    "test:smoke": "node scripts/smoke-sample.mjs",
    "seed:local": "node scripts/make-seed.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@supabase/supabase-js": "^2.118.0",
    "docx": "^9.14.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^9.39.5",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "playwright": "1.56.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
