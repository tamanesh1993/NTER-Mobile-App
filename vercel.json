{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist-web",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://www.nter.pro/api/:path*"
    },
    {
      "source": "/data/:path*",
      "destination": "https://www.nter.pro/data/:path*"
    },
    {
      "source": "/((?!api/|data/|animation/).*)",
      "destination": "/index.html"
    }
  ]
}
